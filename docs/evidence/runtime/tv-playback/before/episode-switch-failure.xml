                              <node index="1" text="2023 · 中国大陆 · 剧情 / 科幻 · 45分钟" resource-id="" class="android.widget.TextView" package="app.panda.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[594,252][1828,294]" drawing-order="2" hint="" display-id="0" />
