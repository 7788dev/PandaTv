                            <node index="2" text="导演：杨磊" resource-id="" class="android.widget.TextView" package="app.panda.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[496,317][1828,357]" drawing-order="3" hint="" display-id="0" />
                            <node index="3" text="主演：张鲁一 / 于和伟 / 陈瑾 / 王子文 / 林永健 / 李小冉" resource-id="" class="android.widget.TextView" package="app.panda.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[496,367][1828,407]" drawing-order="4" hint="" display-id="0" />
                            <node index="4" text="21世纪初，地球基础科学遭到前所未有的动摇，许多科学家绝望疯狂，自杀身亡。风暴即将到来的前夕，许多敏感的人隐隐嗅到毁灭的气息。这一天，纳米科学家汪淼（张鲁一 饰）被粗鲁的警官史强（于和伟 饰）请到联合作战中心，继而得知科学家们的死亡似乎和一个名为“科学边界（ETO）”的组织有关。作战中心希望汪淼潜入该组织，调查他们与死亡科学家乃至一款神秘游戏《三体》的关联。眼前不断倒计时的数字，ETO负责人申玉菲（李小冉 饰）所预测宇宙闪烁，以及《三体》中那不断毁灭又重生的文明，都令汪淼和大史深感困惑与好奇。而看似平凡的老年科学家叶文洁（陈瑾 饰），她的出现又将一切引向数光年外的未知……&#10;本片根据刘慈欣同名科幻小说改编。" resource-id="" class="android.widget.TextView" package="app.panda.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[496,431][1828,564]" drawing-order="5" hint="" display-id="0" />
