                            <node index="3" text="导演：本乡满 / 高桥涉 / 原惠一 / 水岛努 / 武藤裕治" resource-id="" class="android.widget.TextView" package="app.panda.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[496,367][1828,407]" drawing-order="4" hint="" display-id="0" />
                            <node index="4" text="主演：矢岛晶子 / 小林由美子 / 楢桥美纪 / 藤原启治 / 森川智之 / 兴梠里美" resource-id="" class="android.widget.TextView" package="app.panda.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[496,417][1828,457]" drawing-order="5" hint="" display-id="0" />
                            <node index="5" text="小新今年5岁了，不要以为他是那种懵懂无知的小孩，他其实人小鬼大，喜欢漂亮的姐姐，收养了一条棉花糖一样的流浪狗——小白，还经常讲些无厘头的黄色笑话。小新的妈妈美伢是一个全职主妇，粗心而又有点神经质的她经常被小新捉弄得七窍生烟，爸爸野原亦经常被这两母子搞得晕头转向。&#10;《蜡笔小新》的作者以一个5岁小童的眼光，40岁的成年人的心态去观察这个大千世界，看到了许多光怪陆离的景象，小新一家的幽默故事亦由此产生。" resource-id="" class="android.widget.TextView" package="app.panda.tv" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[496,481][1828,614]" drawing-order="6" hint="" display-id="0" />
