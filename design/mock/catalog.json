    { "id": "wugang-laixin", "type": "tv", "title": "雾港来信", "originalTitle": "Letters from the Harbor", "year": 2025, "region": "内地", "genres": ["悬疑", "剧情"], "score": 9.1, "episodes": 24, "unit": "集", "status": "全24集", "runtime": 45, "tag": "独播", "kicker": "本周主推", "tagline": "一封迟到二十年的信", "synopsis": "海事记者沈知夏收到一封寄自二十年前的信，寄信人是早已在海难中失踪的父亲。循着信里的坐标，她回到终年起雾的故乡港口，发现当年那场事故，全镇人都在说谎。", "directors": ["林见川"], "cast": [{ "name": "陆时宜", "role": "饰 沈知夏" }, { "name": "周予安", "role": "饰 陈渡" }, { "name": "顾青禾", "role": "饰 阿汐" }, { "name": "许归远", "role": "饰 老船长" }, { "name": "宋知微", "role": "饰 港务局长" }, { "name": "孟昭然", "role": "饰 邮差" }], "poster": "art/posters/wugang-laixin.webp", "backdrop": "art/backdrops/wugang-laixin.webp" },
    { "id": "changye-jiangming", "type": "tv", "title": "长夜将明", "originalTitle": "Before Dawn", "year": 2025, "region": "内地", "genres": ["刑侦", "悬疑"], "score": 8.8, "episodes": 18, "unit": "集", "status": "更新至18集", "runtime": 48, "tagline": "天亮之前，必须有人开口", "synopsis": "连环纵火案让滨海小城彻夜难眠。被停职的老刑警与刚入行的痕检员被迫搭档，在七十二小时里追一个总比他们早一步的人。天亮之前，必须有人说出真相。", "directors": ["方既白"], "cast": [{ "name": "贺云舟" }, { "name": "岑溪" }, { "name": "祁默" }, { "name": "温叙" }], "poster": "art/posters/changye-jiangming.webp", "backdrop": "art/backdrops/changye-jiangming.webp" },
    { "id": "qingci", "type": "tv", "title": "青瓷", "originalTitle": "Celadon", "year": 2024, "region": "内地", "genres": ["古装", "传奇"], "score": 8.6, "episodes": 40, "unit": "集", "status": "全40集", "runtime": 45, "tagline": "一炉火，烧穿层层黑幕", "synopsis": "南宋龙泉，窑工之女许青禾为替父翻案，女扮男装入官窑。一炉火、一捧土、一句承诺，她烧出了失传的梅子青，也烧穿了层层官场黑幕。", "directors": ["谢听澜"], "cast": [{ "name": "顾青禾" }, { "name": "裴照" }, { "name": "叶疏桐" }, { "name": "秦望" }], "poster": "art/posters/qingci.webp", "backdrop": "art/backdrops/qingci.webp" },
    { "id": "jiuchong-que", "type": "tv", "title": "九重阙", "originalTitle": "Nine Gates", "year": 2025, "region": "内地", "genres": ["古装", "权谋"], "score": 8.4, "episodes": 32, "unit": "集", "status": "更新至32集", "runtime": 46, "kicker": "热播古装", "tagline": "九道宫门，步步为营", "synopsis": "先帝骤崩，遗诏不知所踪。不受宠的七皇子被推上风口浪尖，九道宫门之后，每一位向他行礼的人都另有所图。想活着走出去，只能比所有人都更会下棋。", "directors": ["柏舟"], "cast": [{ "name": "裴照", "role": "饰 七皇子" }, { "name": "叶疏桐", "role": "饰 长公主" }, { "name": "傅深", "role": "饰 首辅" }, { "name": "向晚", "role": "饰 女史" }, { "name": "褚河", "role": "饰 禁军统领" }], "poster": "art/posters/jiuchong-que.webp", "backdrop": "art/backdrops/jiuchong-que.webp" },
    { "id": "nifeng-xiatian", "type": "tv", "title": "逆风的夏天", "originalTitle": "Summer Against the Wind", "year": 2025, "region": "内地", "genres": ["青春", "校园"], "score": 8.2, "episodes": 24, "unit": "集", "status": "全24集", "runtime": 40, "tagline": "至少认真地输一次", "synopsis": "高三那年，田径队只剩下四个人。没有教练，没有经费，只有一条坑坑洼洼的煤渣跑道。他们决定在毕业之前，至少认真地输一次。", "directors": ["乔木"], "cast": [{ "name": "池野" }, { "name": "唐棠" }, { "name": "简宁" }, { "name": "钟意" }], "poster": "art/posters/nifeng-xiatian.webp", "backdrop": "art/backdrops/nifeng-xiatian.webp" },
    { "id": "guiyan", "type": "tv", "title": "归雁", "originalTitle": "Wild Geese Return", "year": 2024, "region": "内地", "genres": ["年代", "家庭"], "score": 8.9, "episodes": 36, "unit": "集", "status": "全36集", "runtime": 45, "tagline": "弄堂里的三代悲欢", "synopsis": "一九八三年，下乡十五年的何以宁带着女儿回到上海弄堂。老房子挤进了三户人家，旧日恋人已成邻居。三代人的悲欢，都装在那扇推不开的木窗后面。", "directors": ["闻笛"], "cast": [{ "name": "何以宁" }, { "name": "许归远" }, { "name": "白露" }, { "name": "应怜" }], "poster": "art/posters/guiyan.webp", "backdrop": "art/backdrops/guiyan.webp" },
    { "id": "diqige-zhengren", "type": "tv", "title": "第七个证人", "originalTitle": "The Seventh Witness", "year": 2025, "region": "内地", "genres": ["律政", "悬疑"], "score": 8.7, "episodes": 10, "unit": "集", "status": "更新至10集", "runtime": 50, "tag": "首播", "tagline": "最后一个证人，坐在陪审席", "synopsis": "一桩证据确凿的杀人案，六位证人口径一致。新人律师宋知微却在庭审前夜收到匿名短信：还有第七个人看见了一切。而那个人，正坐在陪审席上。", "directors": ["言蹊"], "cast": [{ "name": "宋知微" }, { "name": "傅深" }, { "name": "孟昭然" }, { "name": "岑溪" }], "poster": "art/posters/diqige-zhengren.webp", "backdrop": "art/backdrops/diqige-zhengren.webp" },
    { "id": "chaoxi-zhishang", "type": "tv", "title": "潮汐之上", "originalTitle": "Above the Tide", "year": 2025, "region": "内地", "genres": ["都市", "爱情"], "score": 7.9, "episodes": 30, "unit": "集", "status": "全30集", "runtime": 42, "tagline": "住满一个夏天再说", "synopsis": "建筑师陆怀瑾回到海岛，要拆掉外婆留下的旧灯塔民宿。守着民宿的女主人只给他一个条件：住满一个夏天，再决定要不要动手。", "directors": ["乔木"], "cast": [{ "name": "陆怀瑾" }, { "name": "唐棠" }, { "name": "白露" }], "poster": "art/posters/chaoxi-zhishang.webp", "backdrop": "art/backdrops/chaoxi-zhishang.webp" },
    { "id": "shenhai-huisheng", "type": "tv", "title": "深海回声", "originalTitle": "Echoes of the Deep", "year": 2025, "region": "内地", "genres": ["科幻", "冒险"], "score": 8.5, "episodes": 12, "unit": "集", "status": "全12集", "runtime": 55, "tagline": "万米之下，有人回答", "synopsis": "万米海沟传回一段有规律的敲击声。科考船「回声号」奉命下潜调查，船员们很快发现，那声音不仅在回答他们的问题，还在预告他们各自的未来。", "directors": ["林见川"], "cast": [{ "name": "周予安" }, { "name": "简宁" }, { "name": "祁默" }], "poster": "art/posters/shenhai-huisheng.webp", "backdrop": "art/backdrops/shenhai-huisheng.webp" },
    { "id": "yun-shenchu", "type": "tv", "title": "云深处", "originalTitle": "Deep in the Clouds", "year": 2024, "region": "内地", "genres": ["仙侠", "奇幻"], "score": 7.8, "episodes": 40, "unit": "集", "status": "全40集", "runtime": 45, "tagline": "她只想下山回家", "synopsis": "采药少女误入云海之上的隐世宗门，被认作千年前叛出师门的小师祖转世。她只想下山回家，整个修真界却在等她给出一个交代。", "directors": ["柏舟"], "cast": [{ "name": "应怜" }, { "name": "池野" }, { "name": "向晚" }], "poster": "art/posters/yun-shenchu.webp", "backdrop": "art/backdrops/yun-shenchu.webp" },
    { "id": "huijin-zhicheng", "type": "tv", "title": "灰烬之城", "originalTitle": "City of Ashes", "year": 2024, "region": "美国", "genres": ["犯罪", "剧情"], "score": 8.9, "episodes": 10, "unit": "集", "status": "全10集", "runtime": 58, "tagline": "大火之后，旧账难平", "synopsis": "一场大火烧掉了半座城市，也烧出了警局、市政厅与黑帮之间三十年的旧账。调查员伊桑·科尔奉命查清起火点，却发现每条线索都指向自己人。", "directors": ["奥利弗·格兰特"], "cast": [{ "name": "伊桑·科尔" }, { "name": "玛雅·林德" }, { "name": "艾拉·莫里斯" }], "poster": "art/posters/huijin-zhicheng.webp", "backdrop": "art/backdrops/huijin-zhicheng.webp" },
    { "id": "dierci-chuxue", "type": "tv", "title": "第二次初雪", "originalTitle": "Second First Snow", "year": 2025, "region": "韩国", "genres": ["爱情", "治愈"], "score": 8.3, "episodes": 16, "unit": "集", "status": "全16集", "runtime": 62, "tagline": "雪落之前，重新相爱", "synopsis": "失忆的钢琴调音师每年初雪都会忘记一个人。咖啡店老板娘决定在今年雪落之前，让他重新爱上自己——哪怕只有一个冬天。", "directors": ["朴书允"], "cast": [{ "name": "金道贤" }, { "name": "朴书允" }], "poster": "art/posters/dierci-chuxue.webp", "backdrop": "art/backdrops/dierci-chuxue.webp" },
    { "id": "dengta-shouwangzhe", "type": "tv", "title": "灯塔守望者", "originalTitle": "The Keeper", "year": 2023, "region": "英国", "genres": ["悬疑", "剧情"], "score": 9.0, "episodes": 8, "unit": "集", "status": "全8集", "runtime": 56, "tagline": "每一次涨潮都是预告", "synopsis": "孤岛灯塔的老看守人离奇失踪，留下一本写满潮汐数据的日志。前来接任的年轻气象员发现，日志里的每一次涨潮，都对应着岛上一个人的死期。", "directors": ["奥利弗·格兰特"], "cast": [{ "name": "艾拉·莫里斯" }, { "name": "伊桑·科尔" }], "poster": "art/posters/dengta-shouwangzhe.webp", "backdrop": "art/backdrops/dengta-shouwangzhe.webp" },
    { "id": "weigang-fengyun", "type": "tv", "title": "维港风云", "originalTitle": "Harbour Titans", "year": 2025, "region": "中国香港", "genres": ["商战", "家族"], "score": 8.1, "episodes": 20, "unit": "集", "status": "更新至20集", "runtime": 44, "tagline": "一份遗嘱，三分天下", "synopsis": "九七前夜，船王家族的遗产之争搅动整个香江。三兄妹各执一份残缺的遗嘱，谁先凑齐，谁就能拿走码头、银行和父亲不为人知的另一个家。", "directors": ["褚河"], "cast": [{ "name": "傅深" }, { "name": "白露" }, { "name": "秦望" }], "poster": "art/posters/weigang-fengyun.webp", "backdrop": "art/backdrops/weigang-fengyun.webp" },

    { "id": "beiwei-sanshidu", "type": "movie", "title": "北纬三十度", "originalTitle": "30° North", "year": 2025, "region": "内地", "genres": ["剧情", "公路"], "score": 8.7, "runtime": 118, "tagline": "四千公里，学会道别", "synopsis": "货车司机老周接了最后一单活：把一架旧钢琴从上海运到拉萨。同车的是雇主那个一句话也不肯说的女儿。四千公里，足够两个陌生人学会道别。", "directors": ["方既白"], "cast": [{ "name": "许归远" }, { "name": "钟意" }], "poster": "art/posters/beiwei-sanshidu.webp", "backdrop": "art/backdrops/beiwei-sanshidu.webp" },
    { "id": "zuihou-dulun", "type": "movie", "title": "最后一班渡轮", "originalTitle": "The Last Ferry", "year": 2024, "region": "内地", "genres": ["剧情", "爱情"], "score": 8.4, "runtime": 104, "tagline": "这艘船不该独自靠岸", "synopsis": "跨海大桥通车的前一天，开了三十年的轮渡迎来最后一班。船上的人各怀心事：有人要去求婚，有人要去离婚，还有人只是不想让这艘船独自靠岸。", "directors": ["闻笛"], "cast": [{ "name": "何以宁" }, { "name": "贺云舟" }, { "name": "唐棠" }], "poster": "art/posters/zuihou-dulun.webp", "backdrop": "art/backdrops/zuihou-dulun.webp" },
    { "id": "yueqiu-beimian", "type": "movie", "title": "月球背面", "originalTitle": "Far Side", "year": 2025, "region": "内地", "genres": ["科幻", "悬疑"], "score": 8.9, "runtime": 132, "tag": "新片", "kicker": "新片上线", "tagline": "来自三个月后的问候", "synopsis": "二〇四九年，月背基地与地球失联的第四十天。唯一的幸存者林见川收到一段来自地球的问候，发信时间，却是三个月之后。", "directors": ["言蹊"], "cast": [{ "name": "周予安", "role": "饰 林见川" }, { "name": "岑溪", "role": "饰 地面指挥" }, { "name": "温叙", "role": "饰 通讯员" }, { "name": "祁默", "role": "饰 工程师" }], "poster": "art/posters/yueqiu-beimian.webp", "backdrop": "art/backdrops/yueqiu-beimian.webp" },
    { "id": "liusha-zhixia", "type": "movie", "title": "流沙之下", "originalTitle": "Beneath the Dunes", "year": 2025, "region": "内地", "genres": ["冒险", "奇幻"], "score": 7.6, "runtime": 126, "tagline": "壁画上是未来的事", "synopsis": "考古队在罗布泊发现一座被黄沙吞没的唐代驿站，壁画记录的却是尚未发生的事。沙暴逼近，他们必须在被掩埋之前读完最后一面墙。", "directors": ["柏舟"], "cast": [{ "name": "池野" }, { "name": "向晚" }, { "name": "褚河" }], "poster": "art/posters/liusha-zhixia.webp", "backdrop": "art/backdrops/liusha-zhixia.webp" },
    { "id": "xueguo-laike", "type": "movie", "title": "雪国来客", "originalTitle": "A Guest in Snow Country", "year": 2024, "region": "日本", "genres": ["剧情", "文艺"], "score": 8.6, "runtime": 109, "tagline": "一卷没有洗出的胶片", "synopsis": "北海道小镇唯一的旅馆只剩下一位老板娘。大雪封山那晚，来了一位自称是她亡夫旧友的中国旅人，带着一卷没有洗出来的胶片。", "directors": ["佐藤悠"], "cast": [{ "name": "小林千夏" }, { "name": "温叙" }], "poster": "art/posters/xueguo-laike.webp", "backdrop": "art/backdrops/xueguo-laike.webp" },
    { "id": "anhe", "type": "movie", "title": "暗河", "originalTitle": "Undercurrent", "year": 2025, "region": "内地", "genres": ["犯罪", "悬疑"], "score": 8.3, "runtime": 121, "tag": "新片", "tagline": "越往深处，越不敢相认", "synopsis": "失踪十年的姐姐突然出现在地下河探险队的直播画面里。弟弟带着一支临时拼凑的队伍进入溶洞，越往深处，他越不确定自己想找回的是谁。", "directors": ["林见川"], "cast": [{ "name": "贺云舟" }, { "name": "简宁" }, { "name": "孟昭然" }], "poster": "art/posters/anhe.webp", "backdrop": "art/backdrops/anhe.webp" },
    { "id": "tade-cheng", "type": "movie", "title": "她的城", "originalTitle": "Her City", "year": 2025, "region": "内地", "genres": ["剧情", "女性"], "score": 8.8, "runtime": 98, "tagline": "一通打错的电话", "synopsis": "外卖骑手、夜班护士、退休的评弹演员。同一个雨夜，三个女人在同一座城市里各自迷路，又被同一通打错的电话连在一起。", "directors": ["谢听澜"], "cast": [{ "name": "白露" }, { "name": "应怜" }, { "name": "何以宁" }], "poster": "art/posters/tade-cheng.webp", "backdrop": "art/backdrops/tade-cheng.webp" },
    { "id": "zuihou-xunyingren", "type": "movie", "title": "最后的驯鹰人", "originalTitle": "The Last Falconer", "year": 2023, "region": "内地", "genres": ["剧情", "家庭"], "score": 9.0, "runtime": 112, "tagline": "放飞陪伴二十年的鹰", "synopsis": "阿勒泰的雪山下，七十岁的驯鹰人要在入冬前放飞陪伴他二十年的金雕。城里回来的孙子举着相机跟在后面，第一次看懂了爷爷的沉默。", "directors": ["闻笛"], "cast": [{ "name": "许归远" }, { "name": "池野" }], "poster": "art/posters/zuihou-xunyingren.webp", "backdrop": "art/backdrops/zuihou-xunyingren.webp" },
    { "id": "nihong-yibei", "type": "movie", "title": "霓虹以北", "originalTitle": "North of Neon", "year": 2024, "region": "中国香港", "genres": ["爱情", "文艺"], "score": 8.0, "runtime": 101, "tagline": "隔着电波的恋爱", "synopsis": "深夜电台主持人和只在凌晨点歌的听众，隔着电波谈了一场没有见面的恋爱。电台停播那天，她决定去找那个永远点同一首歌的人。", "directors": ["褚河"], "cast": [{ "name": "向晚" }, { "name": "秦望" }], "poster": "art/posters/nihong-yibei.webp", "backdrop": "art/backdrops/nihong-yibei.webp" },
